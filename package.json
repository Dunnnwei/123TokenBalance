{
  "name": "123-token-balance",
  "version": "1.2.0",
  "private": true,
  "description": "多平台 AI 订阅额度与余额工作台",
  "author": "123TokenBalance",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder --win --x64 --dir && node scripts/build-launcher.mjs",
    "release": "node scripts/release.mjs",
    "verify:portable": "node scripts/verify-portable.mjs",
    "verify:release": "python scripts/verify-release.py"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "haui": "file:vendor/haui-0.1.0.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.4",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.123tokenbalance.desktop",
    "productName": "123TokenBalance",
    "directories": {
      "output": "artifacts/package"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "compression": "normal",
    "win": {
      "target": "dir",
      "executableName": "123TokenBalance",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker",
      "icon": "assets/icon.ico"
    }
  }
}
